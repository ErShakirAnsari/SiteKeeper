{
  "manifest_version": 3,
  "name": "SiteKeeper",
  "description": "Block distracting or risky websites behind a master password. Unlock a site for the current tab/session, or for a fixed amount of time.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["storage", "webNavigation", "tabs"],
  "host_permissions": ["<all_urls>"]
}
